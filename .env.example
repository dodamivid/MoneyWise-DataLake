# ------------------------------------------------------------------
# MoneyWise-DataLake — variables de entorno (plantilla)
# Copia este archivo a .env y completa los valores. NUNCA subas .env.
# ------------------------------------------------------------------

# --- MySQL (fuente OLTP) ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=moneywise
MYSQL_USER=moneywise
MYSQL_PASSWORD=moneywise
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Requerido para CDC: binlog en ROW y server-id único
MYSQL_SERVER_ID=184054
MYSQL_BINLOG_FORMAT=ROW

# --- Debezium / usuario de replicación ---
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=dbz

# --- Zookeeper / Kafka ---
ZOOKEEPER_CLIENT_PORT=2181
KAFKA_BROKER_ID=1
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=moneywise

# --- Kafka Connect ---
CONNECT_REST_PORT=8083
CONNECT_GROUP_ID=moneywise-connect
CONNECT_CONFIG_STORAGE_TOPIC=_connect_configs
CONNECT_OFFSET_STORAGE_TOPIC=_connect_offsets
CONNECT_STATUS_STORAGE_TOPIC=_connect_status

# --- Spark ---
SPARK_MASTER=local[*]
BRONZE_PATH=data/bronze
SILVER_PATH=data/silver
GOLD_PATH=data/gold
CHECKPOINT_PATH=checkpoints

# --- Detección de anomalías ---
ANOMALY_METHOD=zscore          # zscore | iqr
ANOMALY_ZSCORE_THRESHOLD=3.0
ANOMALY_TOPIC=moneywise.anomalias

# --- Airflow ---
# --- Airflow ---
AIRFLOW_UID=50000
# Secretos: se generan con el comando de los pasos del Issue 9 (no se escriben a mano)
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
# Minutos de espera entre reintentos de una tarea fallida (2 normal; 1 para probar fallas)
MW_REINTENTO_MINUTOS=2
AIRFLOW_ALERT_EMAIL=you@example.com

# --- GCP / Cloud Storage ---
GCP_PROJECT_ID=your-gcp-project
GCS_BUCKET=moneywise-datalake-gold
# --- GCP / Cloud Storage ---
# Si GCS_BUCKET queda vacío, la tarea subir_gold del DAG se omite (skipped) y el resto del pipeline sigue igual.
GCP_PROJECT_ID=your-gcp-project
# El nombre de un bucket es único en todo el mundo: agrégale un sufijo propio.
GCS_BUCKET=
# Ruta a la llave JSON de la service account, SOLO si corres gcp/subir_gold.py fuera de Docker.
# Dentro de Airflow el compose usa /opt/airflow/gcp/credentials/service-account.json. NO hardcodear el contenido.
GOOGLE_APPLICATION_CREDENTIALS=gcp/credentials/service-account.json
# Ruta (dentro del contenedor/host) al JSON de la service account. NO hardcodear el contenido.
GOOGLE_APPLICATION_CREDENTIALS=gcp/credentials/service-account.json
RAILWAY_MYSQL_HOST=
RAILWAY_MYSQL_PORT=
RAILWAY_MYSQL_USER=debezium
RAILWAY_MYSQL_PASSWORD=